<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="pharmacy_dashboard_view" model="ir.ui.view">
        <field name="name">pharmacy.dashboard.view</field>
        <field name="model">pharmacy.dashboard</field>
        <field name="arch" type="xml">
            <form string="Panel MediZano" create="false" edit="false"><sheet>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div><h1 class="mb-1">Panel operativo MediZano</h1><p class="text-muted mb-0">Ventas, caja e inventario sincronizados con el POS</p></div>
                    <div class="d-flex gap-2">
                        <button name="action_open_sales" type="object" string="Ver ventas" class="btn btn-primary"/>
                        <button name="action_open_inventory" type="object" string="Ver inventario" class="btn btn-secondary"/>
                    </div>
                </div>
                <div class="alert alert-success d-flex align-items-center mb-4" role="status">
                    <i class="fa fa-check-circle me-2"/><span><strong>Datos sincronizados.</strong> Las cifras se leen directamente del POS y del stock actual.</span>
                </div>

                <h3 class="mb-3">Operación de hoy</h3>
                <div class="row g-3 mb-4">
                    <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm p-4">
                        <span class="text-muted fw-bold">VENTA NETA</span><h2 class="text-success mt-2 mb-1"><field name="sales_today" widget="monetary"/></h2><small class="text-muted">Ventas menos devoluciones</small>
                    </div></div>
                    <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm p-4">
                        <span class="text-muted fw-bold">COMPROBANTES</span><h2 class="text-primary mt-2 mb-1"><field name="orders_today"/></h2><small class="text-muted">Ventas registradas hoy</small>
                    </div></div>
                    <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm p-4">
                        <span class="text-muted fw-bold">DEVOLUCIONES</span><h2 class="text-danger mt-2 mb-1"><field name="refunds_today" widget="monetary"/></h2><small class="text-muted">Importe reembolsado hoy</small>
                    </div></div>
                    <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm p-4">
                        <span class="text-muted fw-bold">TICKET PROMEDIO</span><h2 class="mt-2 mb-1"><field name="avg_order_value" widget="monetary"/></h2><small class="text-muted">Promedio del mes</small>
                    </div></div>
                </div>

                <div class="row g-4">
                    <div class="col-lg-7"><div class="card border shadow-sm h-100">
                        <div class="card-header bg-white p-4"><h3 class="mb-1">Resumen de ventas</h3><span class="text-muted">Evolución comercial por periodo</span></div>
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between py-3 border-bottom"><span>Hoy</span><strong><field name="sales_today" widget="monetary"/></strong></div>
                            <div class="d-flex justify-content-between py-3 border-bottom"><span>Esta semana</span><strong><field name="sales_week" widget="monetary"/></strong></div>
                            <div class="d-flex justify-content-between py-3"><span>Este mes</span><strong><field name="sales_month" widget="monetary"/></strong></div>
                        </div>
                    </div></div>
                    <div class="col-lg-5"><div class="card border shadow-sm h-100">
                        <div class="card-header bg-white p-4"><h3 class="mb-1">Inventario disponible</h3><span class="text-muted">Existencias farmacéuticas actuales</span></div>
                        <div class="card-body p-4"><div class="row text-center g-3">
                            <div class="col-6"><div class="bg-light rounded p-3"><h2><field name="total_products"/></h2><span>Medicamentos</span></div></div>
                            <div class="col-6"><div class="bg-light rounded p-3"><h2><field name="stock_units"/></h2><span>Unidades</span></div></div>
                            <div class="col-6"><div class="bg-light rounded p-3"><h2 class="text-warning"><field name="low_stock_products"/></h2><span>Stock bajo</span></div></div>
                            <div class="col-6"><div class="bg-light rounded p-3"><h2 class="text-danger"><field name="out_of_stock_products"/></h2><span>Sin stock</span></div></div>
                        </div></div>
                    </div></div>
                </div>
            </sheet></form>
        </field>
    </record>
    <record id="pharmacy_dashboard_action" model="ir.actions.act_window">
        <field name="name">Panel operativo</field><field name="res_model">pharmacy.dashboard</field><field name="view_mode">form</field><field name="view_id" ref="pharmacy_dashboard_view"/><field name="target">current</field>
    </record>
    <menuitem id="pharmacy_dashboard_menu" name="Panel operativo" parent="menu_pharmacy_root" action="pharmacy_dashboard_action" sequence="1"/>
</data></odoo>
