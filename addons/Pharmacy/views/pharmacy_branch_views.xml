<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Vistas de Sucursales y Boticas -->
        
        <!-- Vista Lista -->
        <record id="view_pharmacy_branch_list" model="ir.ui.view">
            <field name="name">pharmacy.branch.list</field>
            <field name="model">pharmacy.branch</field>
            <field name="arch" type="xml">
                <list string="Sucursales / Boticas">
                    <field name="code" string="Código"/>
                    <field name="name" string="Nombre de la Botica"/>
                    <field name="city" string="Ciudad / Distrito"/>
                    <field name="phone" string="Teléfono"/>
                    <field name="manager_id" string="Químico Farmacéutico / Responsable"/>
                    <field name="total_sales" string="Ventas Totales" widget="monetary"/>
                    <field name="stock_value" string="Valor de Inventario" widget="monetary"/>
                    <field name="active" string="Activa"/>
                </list>
            </field>
        </record>
        
        <!-- Vista Formulario -->
        <record id="view_pharmacy_branch_form" model="ir.ui.view">
            <field name="name">pharmacy.branch.form</field>
            <field name="model">pharmacy.branch</field>
            <field name="arch" type="xml">
                <form string="Configuración de Sucursal / Botica">
                    <header>
                        <button name="action_view_sales" type="object" string="Ver Ventas" class="btn-primary"/>
                        <button name="action_view_stock" type="object" string="Ver Inventario" class="btn-info"/>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Nombre de la Botica / Sucursal *"/>
                            <h1>
                                <field name="name" placeholder="ej. Botica MediZano - Sede Central" required="1"/>
                            </h1>
                            <label for="code" string="Código de Sucursal"/>
                            <p>
                                <field name="code" readonly="1" class="oe_inline" required="0"/>
                            </p>
                        </div>
                        
                        <group name="branch_administration" string="Administración de la Botica">
                            <group name="management_info">
                                <field name="manager_id" string="Responsable / Farmacéutico" options="{'no_create': True}" help="Químico Farmacéutico o encargado de la sucursal"/>
                                <field name="company_id" string="Compañía" groups="base.group_multi_company"/>
                                <field name="user_ids" string="Personal Asignado" widget="many2many_tags" help="Técnicos y farmacéuticos asignados a esta botica"/>
                            </group>
                            <group name="financial_config">
                                <field name="currency_id" string="Moneda" options="{'no_create': True}" required="1"/>
                                <field name="default_pricelist_id" string="Lista de Precios Predeterminada" help="Tarifa de precios por defecto para clientes en esta botica"/>
                                <field name="default_fiscal_position_id" string="Posición Fiscal" help="Configuración tributaria por defecto"/>
                            </group>
                        </group>
                        
                        <group name="branch_contact" string="Datos de Contacto">
                            <group>
                                <field name="phone" string="Teléfono" widget="phone" placeholder="ej. +51-1-4210000"/>
                                <field name="email" string="Correo Electrónico" widget="email" placeholder="ej. botica.central@medizano.pe"/>
                            </group>
                            <group>
                                <field name="website" string="Sitio Web" widget="url" placeholder="ej. https://www.medizano.pe"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Ubicación y Dirección Fiscal" name="address">
                                <group string="Dirección">
                                    <group>
                                        <field name="street" string="Avenida / Calle" placeholder="ej. Av. Arequipa 1450"/>
                                        <field name="street2" string="Interior / Mz / Lote" placeholder="ej. Local 101"/>
                                        <field name="city" string="Distrito / Ciudad" placeholder="ej. Lima" required="1"/>
                                        <field name="state_id" string="Departamento" placeholder="ej. Lima"/>
                                    </group>
                                    <group>
                                        <field name="zip" string="Código Postal" placeholder="ej. 15046"/>
                                        <field name="country_id" string="País" options="{'no_create': True}" required="1"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Configuración Tributaria y de Pagos" name="finance">
                                <group string="Impuestos (SUNAT)">
                                    <group>
                                        <field name="tax_calculation_rounding_method" string="Método de Redondeo de Impuestos"/>
                                        <field name="default_customer_tax_id" string="Impuesto de Venta Predeterminado (IGV 18%)" help="Impuesto general aplicado a medicamentos gravados"/>
                                        <field name="default_supplier_tax_id" string="Impuesto de Compra Predeterminado (IGV 18%)" help="Impuesto aplicado a compras a laboratorios y droguerías"/>
                                    </group>
                                </group>
                                
                                <group string="Plazos de Pago">
                                    <group>
                                        <field name="cash_payment_term_id" string="Plazo de Pago Contado" help="Términos para clientes de venta directa"/>
                                        <field name="insurance_payment_term_id" string="Plazo de Cobro Aseguradoras" help="Términos para liquidaciones de seguros"/>
                                        <field name="supplier_payment_term_id" string="Plazo de Pago Proveedores" help="Términos para facturas de droguerías"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Resumen de Operaciones" name="operations">
                                <group string="Rendimiento de la Botica">
                                    <group>
                                        <field name="total_sales" string="Ventas Totales (S/)" widget="monetary" readonly="1"/>
                                        <field name="stock_value" string="Valor Total de Inventario (S/)" widget="monetary" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="total_claims" string="Total en Convenios (S/)" widget="monetary" readonly="1" help="Total de atenciones por seguro procesadas"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Registros del Sistema Asociados" name="related">
                                <group class="mt-2">
                                    <p class="text-muted" style="font-size: 12px;">
                                        Registros automáticos vinculados: almacenes aislados, puntos de venta y diarios contables.
                                    </p>
                                </group>
                                
                                <group string="Ubicaciones de Almacén Aisladas">
                                    <field name="location_ids" nolabel="1">
                                        <list string="Ubicaciones">
                                            <field name="name" string="Ubicación"/>
                                            <field name="usage" string="Uso"/>
                                            <field name="location_type" string="Tipo de Almacén"/>
                                        </list>
                                    </field>
                                </group>
                                
                                <group string="Puntos de Venta (POS) Asignados">
                                    <field name="pos_config_ids" nolabel="1">
                                        <list string="Terminales POS">
                                            <field name="name" string="Nombre del POS"/>
                                            <field name="active" string="Activo" decoration-success="active == True" decoration-muted="active == False"/>
                                        </list>
                                    </field>
                                </group>
                                
                                <group string="Diarios Contables (Efectivo, Tarjetas, Yape / Plin)">
                                    <field name="journal_ids" nolabel="1">
                                        <list string="Diarios Contables">
                                            <field name="name" string="Diario"/>
                                            <field name="type" string="Tipo"/>
                                            <field name="currency_id" string="Moneda"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Vista Kanban -->
        <record id="view_pharmacy_branch_kanban" model="ir.ui.view">
            <field name="name">pharmacy.branch.kanban</field>
            <field name="model">pharmacy.branch</field>
            <field name="arch" type="xml">
                <kanban string="Sucursales / Boticas">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="city"/>
                    <field name="total_sales"/>
                    <field name="stock_value"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click #{!record.active.raw_value ? 'o_kanban_disabled' : ''}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="code"/> - <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="city"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <div class="row">
                                            <div class="col-6">
                                                <span>Ventas: </span>
                                                <field name="total_sales" widget="monetary"/>
                                            </div>
                                            <div class="col-6">
                                                <span>Inventario: </span>
                                                <field name="stock_value" widget="monetary"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="active" widget="boolean_toggle"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Vista Búsqueda -->
        <record id="view_pharmacy_branch_search" model="ir.ui.view">
            <field name="name">pharmacy.branch.search</field>
            <field name="model">pharmacy.branch</field>
            <field name="arch" type="xml">
                <search string="Buscar Sucursales">
                    <field name="name" string="Nombre de Botica"/>
                    <field name="code" string="Código"/>
                    <field name="city" string="Ciudad / Distrito"/>
                    <field name="manager_id" string="Responsable"/>
                    <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactivas" name="inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Mis Boticas" name="my_branches" domain="[('manager_id', '=', uid)]"/>
                    <separator/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Ciudad / Distrito" name="group_city" context="{'group_by': 'city'}"/>
                        <filter string="Responsable" name="group_manager" context="{'group_by': 'manager_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Acción -->
        <record id="action_pharmacy_branch" model="ir.actions.act_window">
            <field name="name">Sucursales / Boticas</field>
            <field name="res_model">pharmacy.branch</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registrar una nueva sucursal o botica
                </p>
                <p>
                    Las sucursales representan los diferentes locales y puntos de venta de la botica.
                    Cada botica posee inventario independiente, terminales POS y cajas registradoras aisladas.
                </p>
            </field>
        </record>
        
    </data>
</odoo>
