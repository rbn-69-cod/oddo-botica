<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Pharmacy Product Categories -->
        <record id="product_category_medicines" model="product.category">
            <field name="name">Medicines</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>
        
        <record id="product_category_prescription_meds" model="product.category">
            <field name="name">Prescription Medicines</field>
            <field name="parent_id" ref="product_category_medicines"/>
        </record>
        
        <record id="product_category_otc_meds" model="product.category">
            <field name="name">Over-the-Counter Medicines</field>
            <field name="parent_id" ref="product_category_medicines"/>
        </record>
        
        <record id="product_category_controlled_substances" model="product.category">
            <field name="name">Controlled Substances</field>
            <field name="parent_id" ref="product_category_medicines"/>
        </record>
        
        <record id="product_category_medical_supplies" model="product.category">
            <field name="name">Medical Supplies</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>
        
        <record id="product_category_vitamins" model="product.category">
            <field name="name">Vitamins &amp; Supplements</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>
        
        <!-- Default Dosage Forms -->
        <record id="dosage_form_tablet" model="pharmacy.dosage.form">
            <field name="name">Tablet</field>
            <field name="code">TAB</field>
        </record>
        
        <record id="dosage_form_capsule" model="pharmacy.dosage.form">
            <field name="name">Capsule</field>
            <field name="code">CAP</field>
        </record>
        
        <record id="dosage_form_syrup" model="pharmacy.dosage.form">
            <field name="name">Syrup</field>
            <field name="code">SYR</field>
        </record>
        
        <record id="dosage_form_injection" model="pharmacy.dosage.form">
            <field name="name">Injection</field>
            <field name="code">INJ</field>
        </record>
        
        <record id="dosage_form_cream" model="pharmacy.dosage.form">
            <field name="name">Cream</field>
            <field name="code">CRM</field>
        </record>
        
        <record id="dosage_form_drops" model="pharmacy.dosage.form">
            <field name="name">Drops</field>
            <field name="code">DRP</field>
        </record>
        
        <!-- No demo insurers, plans or coverage rules are loaded in production. -->
    </data>
</odoo>
